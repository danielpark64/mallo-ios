{
  "expo": {
    "name": "SayRam",
    "slug": "mallo",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mallo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielpark.sayram",
      "buildNumber": "4",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": [
          "ko",
          "en",
          "ja",
          "zh-Hans",
          "zh-Hant",
          "es",
          "fr",
          "de",
          "pt-BR"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSMicrophoneUsageDescription": "음성 메모를 녹음하기 위해 마이크 접근 권한이 필요합니다.",
        "NSSpeechRecognitionUsageDescription": "말씀하신 내용을 텍스트로 변환하기 위해 음성 인식 권한이 필요합니다.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        },
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "LSApplicationQueriesSchemes": [
          "alarmapp"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "세이람은 사진 보관함을 사용하지 않습니다. 파일 저장에 쓰는 시스템 구성 요소 때문에 필요한 항목입니다."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.danielpark.shared"
        ]
      }
    },
    "android": {
      "package": "com.danielpark.sayram",
      "adaptiveIcon": {
        "backgroundColor": "#141430",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/alarm_long.wav"
          ]
        }
      ],
      "expo-sharing",
      "./plugins/withIosSceneDelegate.js",
      "./plugins/withAndroidReleaseSigning.js",
      "./plugins/withLocalizedAppName.js"
    ],
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json",
      "ja": "./locales/ja.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "pt-BR": "./locales/pt-BR.json"
    }
  }
}
