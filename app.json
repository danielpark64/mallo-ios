{
  "expo": {
    "name": "SayRam",
    "slug": "mallo",
    "version": "1.2.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mallo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielpark.sayram",
      "buildNumber": "24",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": [
          "ko",
          "en",
          "ja",
          "zh-Hans",
          "zh-Hant",
          "es",
          "fr",
          "de",
          "pt-BR"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSMicrophoneUsageDescription": "음성 메모를 녹음하기 위해 마이크 접근 권한이 필요합니다.",
        "NSSpeechRecognitionUsageDescription": "말씀하신 내용을 텍스트로 변환하기 위해 음성 인식 권한이 필요합니다.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        },
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "LSApplicationQueriesSchemes": [
          "alarmapp",
          "whatsapp",
          "line"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "일정에 붙인 사진을 미리보기와 크게 보기로 보여 주려고 사진 보관함을 읽습니다. 사진은 복사하거나 밖으로 보내지 않습니다.",
        "NSAlarmKitUsageDescription": "무음·집중 모드에서도 일정 알람이 시계 앱처럼 울리게 하려면 알람 권한이 필요해요.",
        "NSSupportsLiveActivities": true,
        "NSContactsUsageDescription": "말로 '엄마한테 보내줘'라고 하면 연락처에서 그 사람의 번호를 찾아 문자 작성 화면에 넣어요. 연락처는 이 폰 밖으로 보내지 않아요."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.danielpark.shared"
        ],
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "appleTeamId": "T5Z6ACK2PU",
      "associatedDomains": [
        "applinks:danielpark64.github.io"
      ]
    },
    "android": {
      "package": "com.danielpark.sayram",
      "adaptiveIcon": {
        "backgroundColor": "#141430",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "versionCode": 11,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.WRITE_CONTACTS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "danielpark64.github.io",
              "pathPrefix": "/sayram/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/alarm_long.wav",
            "./assets/silent_short.wav"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-contacts",
        {
          "contactsPermission": "말로 '엄마한테 보내줘'라고 하면 연락처에서 그 사람의 번호를 찾아 문자 작성 화면에 넣어요. 연락처는 이 폰 밖으로 보내지 않아요."
        }
      ],
      "./plugins/withIosSceneDelegate.js",
      "./plugins/withAndroidReleaseSigning.js",
      "./plugins/withLocalizedAppName.js",
      [
        "./plugins/withIosAlarmSounds.js",
        {
          "sounds": [
            "./assets/sounds/snd_digital_beep.caf",
            "./assets/sounds/snd_bell_march.caf",
            "./assets/sounds/snd_old_clock.caf",
            "./assets/sounds/snd_marimba.caf",
            "./assets/sounds/snd_gentle_piano.caf",
            "./assets/sounds/snd_music_box.caf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.danielpark.** { *; }\n-keep class expo.modules.** { *; }"
          }
        }
      ],
      "@bacons/apple-targets",
      "expo-localization"
    ],
    "locales": {
      "ko": "./locales/ko.json",
      "en": "./locales/en.json",
      "ja": "./locales/ja.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "pt-BR": "./locales/pt-BR.json"
    }
  }
}
