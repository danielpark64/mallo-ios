<?xml version="1.0" encoding="utf-8"?>
<!-- 작게: 바로 다음 일정 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/sw_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="14dp" android:background="@drawable/sw_bg">
  <TextView android:id="@+id/sw_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:text="@string/sw_small_name" android:textSize="12sp" android:textColor="@color/sw_accent"/>
  <TextView android:id="@+id/sw_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/sw_sub" android:maxLines="1"/>
  <TextView android:id="@+id/sw_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="20sp" android:textStyle="bold" android:textColor="@color/sw_blue" android:maxLines="1"/>
  <TextView android:id="@+id/sw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="2dp" android:textSize="15sp" android:textColor="@color/sw_text"
    android:maxLines="2" android:ellipsize="end" android:text="@string/sw_open_app"/>
  <TextView android:id="@+id/sw_more" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/sw_sub" android:visibility="gone"/>
</LinearLayout>
