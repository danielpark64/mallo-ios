<?xml version="1.0" encoding="utf-8"?>
<!-- 달력 한 칸: 날짜(오늘은 빨간 원) + 아래 줄(근무 첫 글자·일정 점). 글자는 dp — 시스템 글자 '아주 크게'에서도 칸 안에 들어가게 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/sw_cell" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
  android:orientation="vertical" android:gravity="center_horizontal">
  <TextView android:id="@+id/sw_day" android:layout_width="20dp" android:layout_height="20dp"
    android:gravity="center" android:textSize="12dp" android:includeFontPadding="false"/>
  <TextView android:id="@+id/sw_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="10dp" android:includeFontPadding="false" android:maxLines="1"/>
</LinearLayout>
