<?xml version="1.0" encoding="utf-8"?>
<!-- 크게: 이번 달 달력(날짜 아래 근무 첫 글자 + 일정 점) + 다가오는 일정(손가락 스크롤) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/sw_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="6dp"
  android:background="@drawable/sw_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/sw_month" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:textSize="15dp" android:textStyle="bold" android:textColor="@color/sw_accent" android:maxLines="1"/>
    <ImageView android:id="@+id/sw_mic" android:layout_width="28dp" android:layout_height="28dp" android:padding="4dp"
      android:src="@drawable/sw_ic_mic_red" android:contentDescription="@string/sw_mic"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:layout_marginTop="2dp" android:layout_marginBottom="2dp">
    <TextView android:id="@+id/sw_wd0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:gravity="center" android:textSize="11dp" android:textColor="@color/sw_accent"/>
    <TextView android:id="@+id/sw_wd1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:gravity="center" android:textSize="11dp" android:textColor="@color/sw_sub"/>
    <TextView android:id="@+id/sw_wd2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:gravity="center" android:textSize="11dp" android:textColor="@color/sw_sub"/>
    <TextView android:id="@+id/sw_wd3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:gravity="center" android:textSize="11dp" android:textColor="@color/sw_sub"/>
    <TextView android:id="@+id/sw_wd4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:gravity="center" android:textSize="11dp" android:textColor="@color/sw_sub"/>
    <TextView android:id="@+id/sw_wd5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:gravity="center" android:textSize="11dp" android:textColor="@color/sw_sub"/>
    <TextView android:id="@+id/sw_wd6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:gravity="center" android:textSize="11dp" android:textColor="@color/sw_blue"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/sw_cal" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="1px" android:layout_marginTop="4dp" android:background="@color/sw_divider"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ListView android:id="@+id/sw_list" android:layout_width="match_parent" android:layout_height="match_parent"
      android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none"/>
    <TextView android:id="@+id/sw_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/sw_sub" android:text="@string/sw_open_app" android:visibility="gone"/>
  </FrameLayout>
</LinearLayout>
