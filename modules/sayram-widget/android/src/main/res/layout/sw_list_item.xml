<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/sw_item" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
  <TextView android:id="@+id/sw_item_when" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:minWidth="92dp" android:paddingEnd="8dp" android:textSize="13sp" android:textColor="@color/sw_sub" android:maxLines="1"/>
  <TextView android:id="@+id/sw_item_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
    android:textSize="13sp" android:textColor="@color/sw_text" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
